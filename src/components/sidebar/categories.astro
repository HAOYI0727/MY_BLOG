---
import { getCategoryTree, type CategoryTreeItem } from "@utils/post";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { Icon } from "astro-icon/components";
import WidgetLayout from "./widgetLayout.astro";
import CategoryItem from "./categoryItem.astro";

const categoriesTree = await getCategoryTree();

// 获取顶级分类，按文章数量降序排序
const topLevel = categoriesTree.slice().sort((a, b) => b.count - a.count);

const DEFAULT_SHOW = 3;
const hasMore = topLevel.length > DEFAULT_SHOW;

// 获取国际化文本（用于客户端切换）
const moreText = i18n(I18nKey.more);
const collapseText = i18n(I18nKey.collapse);  // 需确保 I18nKey 中有 collapse

interface Props {
    class?: string;
    style?: string;
    side?: string;
    depth?: number;
}
const { class: className, style, side = "default", depth = 3 } = Astro.props;
---

<WidgetLayout
    name={i18n(I18nKey.categories)}
    id={`categories-${side}`}
    isCollapsed={false}
    class={className}
    style={style}
>
    <div id="categories-container">
        {topLevel.map((node, index) => (
            <div 
                class="category-top-item" 
                data-index={index}
                style:display={index < DEFAULT_SHOW ? 'block' : 'none'}
            >
                <CategoryItem nodes={[node]} maxDepth={depth} />
            </div>
        ))}
    </div>
    {hasMore && (
        <div class="expand-btn px-4 -mb-2">
            <button 
                id="categories-toggle-btn" 
                class="btn-plain rounded-lg w-full h-9 flex items-center justify-center gap-2"
                aria-expanded="false"
            >
                <span id="categories-toggle-text">{moreText}</span>
                <Icon name="material-symbols:more-horiz" class="text-[1.75rem]" id="categories-toggle-icon" />
            </button>
        </div>
    )}
</WidgetLayout>

<script define:vars={{ DEFAULT_SHOW, moreText, collapseText }}>
    const container = document.getElementById('categories-container');
    const btn = document.getElementById('categories-toggle-btn');
    const textSpan = document.getElementById('categories-toggle-text');
    const icon = document.getElementById('categories-toggle-icon');
    if (!btn) return;
    
    const items = container?.querySelectorAll('.category-top-item') || [];
    const total = items.length;
    if (total <= DEFAULT_SHOW) {
        btn.style.display = 'none';
        return;
    }

    let expanded = false;
    btn.addEventListener('click', () => {
        expanded = !expanded;
        items.forEach((el, idx) => {
            el.style.display = (expanded || idx < DEFAULT_SHOW) ? 'block' : 'none';
        });
        textSpan.textContent = expanded ? collapseText : moreText;
        btn.setAttribute('aria-expanded', expanded);
        icon.setAttribute('name', expanded ? 'material-symbols:expand-less' : 'material-symbols:more-horiz');
    });
</script>