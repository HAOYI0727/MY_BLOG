---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getTagList } from "@utils/post";
import { getTagUrl } from "@utils/url";
import ButtonTag from "@/components/common/buttonTag.astro";
import WidgetLayout from "./widgetLayout.astro";

const tags = await getTagList();

const DEFAULT_SHOW = 10;
const displayTags = tags.slice(0, DEFAULT_SHOW);
const hasMore = tags.length > DEFAULT_SHOW;

interface Props {
    class?: string;
    style?: string;
    side?: string;
}
const { class: className, style, side = "default" } = Astro.props;
const tagModalId = "tag-group-modal";
---

<WidgetLayout
    name={i18n(I18nKey.tags)}
    id={`tags-${side}`}
    isCollapsed={false}
    class={className}
    style={style}
>
    <div class="flex gap-2 flex-wrap">
        {displayTags.map(t => (
            <ButtonTag href={getTagUrl(t.name)} label={`查看所有标签为 ${t.name.trim()} 的文章`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
        {hasMore && (
            <button
                type="button"
                class="tags-more-btn btn-plain rounded-lg px-3 py-1 text-(--primary) border border-(--primary) text-sm hover:bg-(--primary)/10 transition-colors"
                data-modal-id={tagModalId}
                aria-haspopup="dialog"
                aria-controls={tagModalId}
                aria-expanded="false"
            >
                {i18n(I18nKey.more)}...
            </button>
        )}
    </div>
</WidgetLayout>
