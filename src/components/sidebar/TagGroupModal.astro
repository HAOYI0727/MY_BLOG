---
import type { CategoryTagGroup } from "@utils/post";
import { getTagUrl } from "@utils/url";
import { Icon } from "astro-icon/components";

interface Props {
    groups: CategoryTagGroup[];
    id?: string;
}
const { groups, id = "tag-group-modal" } = Astro.props;

// 计算总标签数
const totalTags = groups.reduce((sum, g) => sum + g.tags.length, 0);
---

<dialog id={id} class="tag-group-modal">
    <div class="modal-content">
        <!-- 关闭按钮：直接使用内联 onclick，最可靠 -->
        <button class="close-btn" aria-label="关闭标签面板" title="关闭 (ESC)" onclick="document.getElementById('tag-group-modal').close()">
            <Icon name="material-symbols:close" class="text-2xl" />
        </button>

        <!-- 头部：标题 + 统计 -->
        <div class="modal-header">
            <h2 class="modal-title">
                所有标签
                <span class="tag-count-badge">{totalTags}</span>
            </h2>
            <p class="subtitle">点击标签可筛选对应文章</p>
        </div>

        <!-- 标签分组列表（无搜索） -->
        <div class="modal-body">
            {groups.map(group => (
                <div class="group-section" data-category={group.category}>
                    <h3 class="group-title">
                        <Icon name="material-symbols:folder" class="group-icon" />
                        {group.category}
                        <span class="group-count">{group.tags.length}</span>
                    </h3>
                    <div class="tags-container">
                        {group.tags.map(tag => (
                            <a 
                                href={getTagUrl(tag)} 
                                class="tag-link"
                                data-tag={tag}
                            >
                                {tag}
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</dialog>

<style>
    .tag-group-modal {
        border: none;
        padding: 0;
        background: transparent;
        width: 92vw;
        max-width: 820px;
        max-height: 88vh;
        position: fixed;
        inset: 0;
        margin: auto;
        z-index: 99999;
        border-radius: var(--radius-large, 1.2rem);
        overflow: visible;
        display: flex;
        flex-direction: column;
        opacity: 0;
        transform: scale(0.92) translateY(12px);
        transition: opacity 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        pointer-events: none;
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
    }
    .tag-group-modal[open] {
        opacity: 1;
        transform: scale(1) translateY(0);
        pointer-events: auto;
    }
    .tag-group-modal::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 99998;
    }

    .modal-content {
        background: var(--card-bg);
        border-radius: var(--radius-large, 1.2rem);
        padding: 2rem 2rem 1.8rem;  /* 右侧留出空间给关闭按钮，稍后调整 */
        max-height: 88vh;
        overflow-y: auto;
        position: relative;  /* 设为 relative，供绝对定位子元素参考 */
        flex: 1;
        border: 1px solid var(--modal-border-color, rgba(255, 255, 255, 0.08));
        backdrop-filter: blur(2px);
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .close-btn {
        position: absolute;      /* 绝对定位到右上角 */
        top: 0.8rem;
        right: 0.8rem;
        z-index: 10;
        background: var(--btn-regular-bg);
        border-radius: 50%;
        width: 2.6rem;
        height: 2.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        color: var(--text-color);
        font-size: 1.4rem;
        flex-shrink: 0;
        /* 移除之前的 float 和 margin */
    }
    
    .close-btn:hover {
        background: var(--btn-regular-bg-hover);
        transform: rotate(90deg) scale(1.05);
        color: var(--primary);
    }

    /* 头部 */
    .modal-header {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        margin-top: -0.2rem;
        clear: both;
    }
    .modal-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 0.02em;
        border-bottom: 3px solid var(--primary);
        padding-bottom: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        width: fit-content;
    }
    .tag-count-badge {
        font-size: 0.8rem;
        font-weight: 600;
        background: var(--primary);
        color: var(--bg);
        padding: 0.1rem 0.7rem;
        border-radius: 999px;
        margin-left: 0.2rem;
        line-height: 1.6;
    }
    .subtitle {
        font-size: 0.9rem;
        color: var(--text-secondary, #666);
        margin: 0.2rem 0 0.2rem 0.1rem;
    }

    /* 标签主体 */
    .modal-body {
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
        flex: 1;
        overflow-y: auto;
        padding-right: 0.2rem;
    }

    .group-section {
        break-inside: avoid;
        border-bottom: 1px dashed var(--border-color, #eee);
        padding-bottom: 1.2rem;
    }
    .group-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .group-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--primary);
        margin: 0 0 0.6rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-left: 4px solid var(--primary);
        padding-left: 0.8rem;
    }
    .group-icon {
        font-size: 1.1rem;
        opacity: 0.8;
    }
    .group-count {
        font-size: 0.7rem;
        background: var(--btn-regular-bg);
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        margin-left: auto;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .tags-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 0.6rem;
        padding-left: 0.2rem;
    }

    .tag-link {
        transition: all 0.2s ease;
        text-decoration: none;
        background: var(--btn-regular-bg);
        color: var(--text-color);
        border-radius: 999px;
        padding: 0.3rem 0.8rem;
        font-size: 0.85rem;
        border: 1px solid transparent;
        cursor: pointer;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .tag-link:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 6px 14px rgba(var(--primary-rgb, 0,0,0), 0.2);
    }
    .tag-link:active {
        transform: scale(0.96);
    }

    /* 暗色模式适配 */
    .dark .modal-content {
        --modal-border-color: rgba(255, 255, 255, 0.06);
        background: var(--card-bg);
    }
    .dark .tag-link {
        background: rgba(255, 255, 255, 0.06);
    }
    .dark .tag-link:hover {
        background: var(--primary);
        color: #fff;
    }
    .dark .group-section {
        border-color: rgba(255, 255, 255, 0.06);
    }

    /* 响应式 */
    @media (max-width: 640px) {
        .modal-content { padding: 1.2rem; }
        .modal-title { font-size: 1.3rem; }
        .tags-container { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
        .tag-link { font-size: 0.8rem; padding: 0.2rem 0.6rem; }
        .close-btn { width: 2.2rem; height: 2.2rem; }
    }
</style>

<script>
    (function() {
        const dialog = document.getElementById('tag-group-modal');
        if (!dialog) return;

        // 点击背景（dialog自身）关闭
        dialog.addEventListener('click', (e) => {
            if (e.target === dialog) {
                dialog.close();
            }
        });

        // ESC键关闭：浏览器默认支持，但防止 cancel 默认行为
        dialog.addEventListener('cancel', (e) => {
            e.preventDefault();
            dialog.close();
        });

        // 可选：点击标签链接时关闭模态框（跳转由 a 标签处理）
        dialog.addEventListener('click', (e) => {
            const link = e.target.closest('.tag-link');
            if (link) {
                // 延迟关闭以确保点击事件传播完成（跳转）
                setTimeout(() => dialog.close(), 50);
            }
        });
    })();
</script>