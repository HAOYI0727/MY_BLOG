---
import type { CategoryTagGroup } from "@utils/post";
import { getTagUrl } from "@utils/url";
import { Icon } from "astro-icon/components";

interface Props {
    groups: CategoryTagGroup[];
    id?: string;
}
const { groups, id = "tag-group-modal" } = Astro.props;

// 计算总标签数
const totalTags = groups.reduce((sum, g) => sum + g.tags.length, 0);
const clientGroups = groups.map((group) => ({
    category: group.category,
    tags: group.tags.map((tag) => ({ name: tag, href: getTagUrl(tag) })),
}));
// 防止标签文本中的“<”被浏览器当作 script 结束标记解析。
const serializedGroups = JSON.stringify(clientGroups).replace(/</g, "\\u003c");
---

<dialog id={id} class="tag-group-modal" aria-hidden="true" inert>
    <div class="modal-content">
        <button type="button" class="close-btn" aria-label="关闭标签面板" title="关闭 (ESC)">
            <Icon name="material-symbols:close" class="text-2xl" />
        </button>

        <!-- 头部：标题 + 统计 -->
        <div class="modal-header">
            <h2 class="modal-title">
                所有标签
                <span class="tag-count-badge">{totalTags}</span>
            </h2>
            <p class="subtitle">点击标签可筛选对应文章</p>
            <label class="tag-search">
                <Icon name="material-symbols:search-rounded" class="search-icon" />
                <span class="sr-only">搜索标签</span>
                <input
                    type="search"
                    class="tag-search-input"
                    placeholder="搜索标签或分类…"
                    autocomplete="off"
                    spellcheck="false"
                />
            </label>
            <p class="filter-status" aria-live="polite">共 {totalTags} 个标签</p>
        </div>

        <!-- 标签列表首次打开时再创建，减少每个页面的初始 DOM 和解析时间。 -->
        <div class="modal-body">
            <div class="empty-state" hidden>
                <Icon name="material-symbols:search-off-rounded" class="empty-icon" />
                <p>没有找到匹配的标签</p>
            </div>
        </div>
        <script is:inline type="application/json" class="tag-group-data" set:html={serializedGroups}></script>
    </div>
</dialog>

<style is:global>
    .tag-group-modal {
        border: none;
        padding: 0;
        background: transparent;
        width: min(94vw, 920px);
        height: min(88dvh, 820px);
        max-width: none;
        max-height: none;
        position: fixed;
        inset: 0;
        margin: auto;
        z-index: 99999;
        border-radius: var(--radius-large, 1.2rem);
        overflow: hidden;
        display: none;
        flex-direction: column;
        opacity: 0;
        transform: scale(0.92) translateY(12px);
        transition: opacity 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        pointer-events: none;
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
    }
    .tag-group-modal[open] {
        display: flex;
        opacity: 1;
        transform: scale(1) translateY(0);
        pointer-events: auto;
    }
    .tag-group-modal::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 99998;
    }

    .modal-content {
        background: var(--card-bg);
        border-radius: var(--radius-large, 1.2rem);
        padding: 1.6rem 1.6rem 1.4rem;
        width: 100%;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        position: relative;
        border: 1px solid var(--modal-border-color, rgba(255, 255, 255, 0.08));
        backdrop-filter: blur(2px);
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .close-btn {
        position: absolute;      /* 绝对定位到右上角 */
        top: 0.8rem;
        right: 0.8rem;
        z-index: 10;
        background: var(--btn-regular-bg);
        border-radius: 50%;
        width: 2.6rem;
        height: 2.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        color: var(--text-color);
        font-size: 1.4rem;
        flex-shrink: 0;
        /* 移除之前的 float 和 margin */
    }
    
    .close-btn:hover {
        background: var(--btn-regular-bg-hover);
        transform: rotate(90deg) scale(1.05);
        color: var(--primary);
    }

    /* 头部 */
    .modal-header {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        margin-top: -0.2rem;
        clear: both;
    }
    .modal-title {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 0.02em;
        border-bottom: 3px solid var(--primary);
        padding-bottom: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        width: fit-content;
    }
    .tag-count-badge {
        font-size: 0.8rem;
        font-weight: 600;
        background: var(--primary);
        color: var(--bg);
        padding: 0.1rem 0.7rem;
        border-radius: 999px;
        margin-left: 0.2rem;
        line-height: 1.6;
    }
    .subtitle {
        font-size: 0.9rem;
        color: var(--text-secondary, #666);
        margin: 0.2rem 0 0.2rem 0.1rem;
    }

    .tag-search {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-height: 2.75rem;
        padding: 0 0.85rem;
        margin-top: 0.35rem;
        border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
        border-radius: 0.85rem;
        background: var(--btn-regular-bg);
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .tag-search:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent);
    }
    .search-icon {
        flex: none;
        color: var(--primary);
        font-size: 1.25rem;
    }
    .tag-search-input {
        width: 100%;
        min-width: 0;
        padding: 0.7rem 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text-color);
        font: inherit;
    }
    .filter-status {
        margin: -0.15rem 0 0 0.1rem;
        color: var(--text-secondary, #666);
        font-size: 0.78rem;
    }

    /* 标签主体 */
    .modal-body {
        display: flex;
        flex-direction: column;
        gap: 1.8rem;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
        padding: 0.1rem 0.45rem 0.5rem 0;
    }

    .group-section {
        break-inside: avoid;
        border-bottom: 1px dashed var(--border-color, #eee);
        padding-bottom: 1.2rem;
    }
    .group-section:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .group-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--primary);
        margin: 0 0 0.6rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-left: 4px solid var(--primary);
        padding-left: 0.8rem;
    }
    .group-icon {
        font-size: 1.1rem;
        opacity: 0.8;
        line-height: 1;
    }
    .group-count {
        font-size: 0.7rem;
        background: var(--btn-regular-bg);
        padding: 0.1rem 0.6rem;
        border-radius: 999px;
        margin-left: auto;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .tags-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 0.6rem;
        padding-left: 0.2rem;
    }

    .tag-link {
        transition: all 0.2s ease;
        text-decoration: none;
        background: var(--btn-regular-bg);
        color: var(--text-color);
        border-radius: 999px;
        padding: 0.3rem 0.8rem;
        font-size: 0.85rem;
        border: 1px solid transparent;
        cursor: pointer;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 2.35rem;
        line-height: 1.3;
        white-space: normal;
        overflow-wrap: anywhere;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .tag-link:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 6px 14px rgba(var(--primary-rgb, 0,0,0), 0.2);
    }
    .tag-link:active {
        transform: scale(0.96);
    }

    .empty-state {
        flex: 1;
        min-height: 12rem;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.7rem;
        color: var(--text-secondary, #666);
        text-align: center;
    }
    .empty-state:not([hidden]) {
        display: flex;
    }
    .empty-icon {
        color: var(--primary);
        font-size: 2rem;
        opacity: 0.75;
    }

    /* 暗色模式适配 */
    .dark .modal-content {
        --modal-border-color: rgba(255, 255, 255, 0.06);
        background: var(--card-bg);
    }
    .dark .tag-link {
        background: rgba(255, 255, 255, 0.06);
    }
    .dark .tag-link:hover {
        background: var(--primary);
        color: #fff;
    }
    .dark .group-section {
        border-color: rgba(255, 255, 255, 0.06);
    }

    /* 响应式 */
    @media (max-width: 640px) {
        .tag-group-modal {
            width: 94vw;
            height: 90dvh;
        }
        .modal-content { padding: 1.15rem 1rem 1rem; gap: 0.85rem; }
        .modal-title { font-size: 1.3rem; }
        .tags-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .tag-link { font-size: 0.8rem; padding: 0.35rem 0.55rem; }
        .close-btn { width: 2.2rem; height: 2.2rem; }
    }
</style>

<script>
    type ClientTagGroup = {
        category: string;
        tags: Array<{ name: string; href: string }>;
    };

    const setupTagGroupModal = () => {
        const previousController = (window as any).__tagGroupModalController as AbortController | undefined;
        previousController?.abort();

        const controller = new AbortController();
        const { signal } = controller;
        (window as any).__tagGroupModalController = controller;

        const dialog = document.getElementById("tag-group-modal") as HTMLDialogElement | null;
        if (!dialog) return;

        const body = dialog.querySelector<HTMLElement>(".modal-body");
        const dataElement = dialog.querySelector<HTMLScriptElement>(".tag-group-data");
        const searchInput = dialog.querySelector<HTMLInputElement>(".tag-search-input");
        const status = dialog.querySelector<HTMLElement>(".filter-status");
        const emptyState = dialog.querySelector<HTMLElement>(".empty-state");
        const closeButton = dialog.querySelector<HTMLButtonElement>(".close-btn");
        const totalTags = Number(dialog.querySelector(".tag-count-badge")?.textContent || 0);
        let sections: HTMLElement[] = [];
        let rendered = false;
        let activeButton: HTMLButtonElement | null = null;

        const ensureTagsRendered = () => {
            if (rendered || !body || !dataElement || !emptyState) return;

            let groups: ClientTagGroup[] = [];
            try {
                groups = JSON.parse(dataElement.textContent || "[]") as ClientTagGroup[];
            } catch (error) {
                console.error("Failed to parse tag groups", error);
            }

            const fragment = document.createDocumentFragment();
            for (const group of groups) {
                const section = document.createElement("section");
                section.className = "group-section";
                section.dataset.category = group.category;

                const heading = document.createElement("h3");
                heading.className = "group-title";

                const icon = document.createElement("span");
                icon.className = "group-icon";
                icon.setAttribute("aria-hidden", "true");
                icon.textContent = "▸";

                const label = document.createElement("span");
                label.textContent = group.category;

                const count = document.createElement("span");
                count.className = "group-count";
                count.textContent = String(group.tags.length);

                heading.append(icon, label, count);

                const tagContainer = document.createElement("div");
                tagContainer.className = "tags-container";
                for (const tag of group.tags) {
                    const link = document.createElement("a");
                    link.className = "tag-link";
                    link.href = tag.href;
                    link.dataset.tag = tag.name;
                    link.textContent = tag.name;
                    tagContainer.append(link);
                }

                section.append(heading, tagContainer);
                fragment.append(section);
            }

            body.insertBefore(fragment, emptyState);
            sections = Array.from(body.querySelectorAll<HTMLElement>(".group-section"));
            rendered = true;
        };

        const filterTags = () => {
            if (!rendered || !status || !emptyState) return;
            const query = searchInput?.value.trim().toLocaleLowerCase() || "";
            let visibleTags = 0;

            for (const section of sections) {
                const category = (section.dataset.category || "").toLocaleLowerCase();
                const categoryMatches = !!query && category.includes(query);
                let visibleInGroup = 0;

                for (const link of section.querySelectorAll<HTMLElement>(".tag-link")) {
                    const tag = (link.dataset.tag || "").toLocaleLowerCase();
                    const visible = !query || categoryMatches || tag.includes(query);
                    link.hidden = !visible;
                    if (visible) visibleInGroup += 1;
                }

                section.hidden = visibleInGroup === 0;
                const count = section.querySelector<HTMLElement>(".group-count");
                if (count) count.textContent = String(visibleInGroup);
                visibleTags += visibleInGroup;
            }

            status.textContent = query
                ? `找到 ${visibleTags} 个标签`
                : `共 ${totalTags} 个标签`;
            emptyState.hidden = visibleTags !== 0;
        };

        const openModal = (button: HTMLButtonElement) => {
            ensureTagsRendered();
            activeButton = button;
            dialog.removeAttribute("inert");
            dialog.setAttribute("aria-hidden", "false");
            button.setAttribute("aria-expanded", "true");
            if (!dialog.open) dialog.showModal();
            window.requestAnimationFrame(() => searchInput?.focus());
        };

        const closeModal = () => {
            if (dialog.open) dialog.close();
        };

        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const trigger = target.closest<HTMLButtonElement>(
                '.tags-more-btn[data-modal-id="tag-group-modal"]',
            );
            if (trigger) {
                event.preventDefault();
                openModal(trigger);
                return;
            }

            if (target.closest(".tag-group-modal .tag-link")) closeModal();
        }, { signal });

        closeButton?.addEventListener("click", closeModal, { signal });
        searchInput?.addEventListener("input", filterTags, { signal });
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) closeModal();
        }, { signal });
        dialog.addEventListener("close", () => {
            dialog.setAttribute("aria-hidden", "true");
            dialog.setAttribute("inert", "");
            document.querySelectorAll<HTMLButtonElement>(
                '.tags-more-btn[data-modal-id="tag-group-modal"]',
            ).forEach((button) => button.setAttribute("aria-expanded", "false"));
            if (searchInput) {
                searchInput.value = "";
                filterTags();
            }
            activeButton?.focus();
            activeButton = null;
        }, { signal });
    };

    setupTagGroupModal();
</script>
