---
// src/pages/posts/index.astro
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { getSortedPostsList } from "@utils/post";
import GridLayout from "@layouts/grid.astro";

const pageTitle = LinkPresets[LinkPreset.Posts].name;
const pageDescription = LinkPresets[LinkPreset.Posts].description;

const allPosts = await getSortedPostsList();

// 按年月分组，记录最早文章的封面
type MonthGroup = {
  year: number;
  month: number;
  count: number;
  earliestCover: string | null; // 最早文章的封面
  earliestDate: Date | null;    // 辅助比较
};
const monthMap = new Map<string, MonthGroup>();

for (const post of allPosts) {
  const date = post.data.published;
  if (!date) continue;
  const year = date.getFullYear();
  const month = date.getMonth() + 1;
  const key = `${year}-${String(month).padStart(2, "0")}`;
  if (!monthMap.has(key)) {
    monthMap.set(key, {
      year,
      month,
      count: 0,
      earliestCover: null,
      earliestDate: null,
    });
  }
  const group = monthMap.get(key)!;
  group.count += 1;
  // 如果该月还没有记录日期，或当前日期更早，则更新为最早文章的封面
  if (!group.earliestDate || date < group.earliestDate) {
    group.earliestDate = date;
    // 只保存有效的封面
    const cover = post.data.cover;
    if (cover && typeof cover === 'string' && cover.trim() !== '') {
      group.earliestCover = cover;
    } else {
      group.earliestCover = null;
    }
  }
}

// 按年份降序，月份降序排列（最新在前）
const monthGroups = Array.from(monthMap.values()).sort((a, b) => {
  if (a.year !== b.year) return b.year - a.year;
  return b.month - a.month;
});

const monthNames = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
---

<GridLayout title={pageTitle} description={pageDescription}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 标题区 -->
      <header class="mb-10 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
            {pageTitle}
          </h1>
          {pageDescription && (
            <p class="text-neutral-600 dark:text-neutral-400">
              {pageDescription}
            </p>
          )}
        </div>
        <span class="inline-flex items-center gap-1 px-3 py-1 bg-(--primary)/10 text-(--primary) text-sm rounded-full font-medium">
          <span class="i-ic:round-article w-4 h-4"></span>
          {allPosts.length} 篇
        </span>
      </header>

      <!-- 月份卡片网格：每行3个，1:1方形 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {monthGroups.map(({ year, month, count, earliestCover }) => {
          // 构建月份链接
          const monthLink = `/posts/${year}/${String(month).padStart(2, "0")}/`;
          // 如果没有封面，生成渐变色背景
          const hue = (year * 31 + month * 7) % 360;
          const bgGradient = `linear-gradient(135deg, hsl(${hue}, 70%, 60%), hsl(${(hue + 40) % 360}, 70%, 50%))`;
          
          return (
            <a
              href={monthLink}
              class="group relative block rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-400 hover:-translate-y-2 bg-white dark:bg-gray-800"
              style="aspect-ratio: 1/1;"
            >
              <!-- 背景图片或渐变 -->
              <div class="absolute inset-0 overflow-hidden">
                {earliestCover ? (
                  <img
                    src={earliestCover}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                ) : (
                  // 无封面：渐变背景 + 装饰
                  <div class="absolute inset-0" style={`background: ${bgGradient};`}>
                    <div class="absolute inset-0 opacity-30 bg-[radial-gradient(circle_at_30%_30%,white,transparent)]"></div>
                    <div class="absolute bottom-0 right-0 w-32 h-32 rounded-full bg-white/10 blur-2xl"></div>
                  </div>
                )}
                {/* 深色渐变遮罩，确保底部文字可读 */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              </div>

              {/* 底部信息区域 */}
              <div class="absolute bottom-0 left-0 right-0 p-5 text-white z-10">
                <div class="text-xl font-bold drop-shadow-lg leading-tight">
                  {year}年{monthNames[month-1]}
                </div>
                <div class="flex items-center gap-2 text-sm opacity-90 drop-shadow-md mt-1">
                  <span class="i-ic:round-article w-4 h-4"></span>
                  <span>{count} 篇文章</span>
                  {earliestCover && (
                    <span class="text-xs opacity-70 ml-1">· 封面图</span>
                  )}
                </div>
              </div>

              {/* 悬停光晕效果 */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
                <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent"></div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- 底部统计 -->
      <div class="mt-12 text-center text-60 text-sm">
        共 {monthGroups.length} 个月份归档
      </div>
    </div>
  </div>
</GridLayout>

<style is:global>
  /* 保证卡片是1:1正方形 */
  .aspect-\[1\/1\] {
    aspect-ratio: 1 / 1;
  }
  /* 图片加载失败时隐藏 */
  .absolute.inset-0 > img[style*="display: none"] {
    display: none !important;
  }
  /* 暗色模式下卡片背景 */
  .dark .group.bg-white {
    background-color: #1f1f1f;
  }
</style>