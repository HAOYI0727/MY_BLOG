---
// 保留所有原有的 imports 和配置
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

import { siteConfig, profileConfig, postConfig } from "@/config";
import { getSortedPosts } from "@utils/post";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getFileDirFromPath, getPostUrl, getPostUrlBySlug, removeFileExtension, url } from "@utils/url";
import { SUPPORTED_LANGUAGES, langToTranslateMap } from "@i18n/language";
import { i18n, getTranslation } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import License from "@components/post/license.astro";
import Markdown from "@components/common/markdown.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import PasswordProtection from "@components/common/passwordProtection.astro";
import PostMetadata from "@components/post/postMeta.astro";
import Comment from "@components/comment.astro";
import GridLayout from "@layouts/grid.astro";

export async function getStaticPaths() {
    const blogEntries = await getSortedPosts();
    const paths: {
        params: { slug: string };
        props: { entry: CollectionEntry<"posts"> };
    }[] = [];

    for (const entry of blogEntries) {
        const slug = removeFileExtension(entry.id);
        paths.push({
            params: { slug },
            props: { entry },
        });
        if (entry.data.routeName) {
            let routeName = entry.data.routeName
                .replace(/^\/+/, "")
                .replace(/\/+$/, "");
            if (routeName.startsWith("posts/")) {
                routeName = routeName.replace(/^posts\//, "");
            }
            paths.push({
                params: { slug: routeName },
                props: { entry },
            });
        }
    }

    return paths;
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

// 加密逻辑
let isEncrypted = !!(entry.data.encrypted && entry.data.password);

dayjs.extend(utc);
const lastModified = dayjs(entry.data.updated || entry.data.published)
    .utc()
    .format("YYYY-MM-DDTHH:mm:ss");

const lastModifiedKeys = [
    I18nKey.lastModifiedPrefix,
    I18nKey.year,
    I18nKey.month,
    I18nKey.day,
    I18nKey.hour,
    I18nKey.minute,
    I18nKey.second
];

const lastModifiedTranslations = {};
for (const lang of SUPPORTED_LANGUAGES) {
    const translateCode = langToTranslateMap[lang];
    lastModifiedTranslations[translateCode] = {};
    const translation = getTranslation(lang);
    for (const key of lastModifiedKeys) {
        lastModifiedTranslations[translateCode][key] = translation[key];
    }
}

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description || entry.data.title,
    keywords: entry.data.tags,
    author: {
        "@type": "Person",
        name: profileConfig.name,
        url: Astro.site,
    },
    datePublished: formatDateToYYYYMMDD(entry.data.published!),
    inLanguage: entry.data.lang
        ? entry.data.lang.replace("_", "-")
        : siteConfig.lang.replace("_", "-"),
};

// 获取当前文章的完整 URL，用于分享
const postUrl = getPostUrl(entry);
const fullPostUrl = new URL(postUrl, Astro.site).toString();
const postTitle = entry.data.title;
const postDesc = entry.data.description || postTitle;
---

<div id="progress-bar-wrapper" aria-hidden="true" class="fixed top-0 left-0 w-full h-1 z-[999] pointer-events-none opacity-0 transition-opacity duration-200">
    <div id="progress-bar-fill" class="h-full w-full origin-left bg-(--primary)" style="transform: scaleX(0);"></div>
</div>

<GridLayout
    banner={entry.data.cover}
    title={entry.data.title}
    description={entry.data.description}
    lang={entry.data.lang}
    setOGTypeArticle={true}
    postSlug={entry.id}
    headings={headings}
>
    <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
    />

    <div
        class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
    >
        <div
            id="post-container"
            class:list={[
                "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
                {},
            ]}
        >
            <nav class="post-reader-nav" aria-label="文章浏览导航">
                <a
                    href={url("/")}
                    class="post-reader-nav__item"
                    aria-label={i18n(I18nKey.backTo)}
                    title={i18n(I18nKey.backTo)}
                >
                    <Icon name="material-symbols:arrow-back-rounded" />
                    <span>{i18n(I18nKey.backTo)}</span>
                </a>
            </nav>

            <!-- 字数统计 & 阅读时间 -->
            <div
                class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation-up"
            >
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon name="material-symbols:notes-rounded" />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.words}
                        {" " + i18n(I18nKey.wordsCount)}
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon
                            name="material-symbols:schedule-outline-rounded"
                        />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes}
                        {" " +
                            i18n(
                                remarkPluginFrontmatter.minutes === 1
                                    ? I18nKey.minuteCount
                                    : I18nKey.minutesCount,
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- 标题 -->
            <div class="relative onload-animation-up">
                <div
                    data-pagefind-body
                    data-pagefind-weight="10"
                    data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
                >
                    {entry.data.title}
                </div>
            </div>

            <!-- 元数据 -->
            <div class="onload-animation-up">
                <PostMetadata
                    className="mb-5"
                    published={entry.data.published!}
                    updated={entry.data.updated}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    postUrl={getPostUrl(entry)}
                />
                {
                    (!entry.data.cover || (entry.data.cover && !entry.data.coverInContent)) && (
                        <div class="mt-4 border-(--line-divider) border-dashed border-b mb-5" />
                    )
                }
            </div>

            <!-- 封面图 -->
            {
                entry.data.cover && entry.data.coverInContent && (
                    <>
                        <div class="mt-4" />
                        <ImageWrapper
                            id="post-cover"
                            src={entry.data.cover}
                            basePath={getFileDirFromPath(entry.filePath || '')}
                            class="mb-8 rounded-xl banner-container onload-animation-up"
                            loading="lazy"
                        />
                    </>
                )
            }

            <!-- 正文 -->
            <PasswordProtection
                isEncrypted={isEncrypted}
                password={entry.data.password}
            >
                <Markdown class="mb-6 markdown-content onload-animation-up">
                    <Content />
                </Markdown>
                {
                    postConfig.license.enable && (
                        <License
                            title={entry.data.title}
                            id={entry.id}
                            pubDate={entry.data.published!}
                            author={entry.data.author}
                            sourceLink={entry.data.sourceLink}
                            licenseName={entry.data.licenseName}
                            licenseUrl={entry.data.licenseUrl}
                            postUrl={getPostUrl(entry)}
                            class="mb-6 rounded-xl license-container onload-animation-up"
                        />
                    )
                }
            </PasswordProtection>
        </div>
    </div>

    <!-- 分享按钮组（使用 fa6-brands / fa6-solid 图标） -->
            <div class="onload-animation-up mb-4">
                <div class="flex flex-wrap items-center gap-2 text-black/60 dark:text-white/60 text-sm">
                    <span class="mr-1 select-none">{i18n(I18nKey.share) || "分享："}</span>
                    <!-- QQ 分享 -->
                    <button
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="qq"
                        aria-label="分享到 QQ"
                        title="分享到 QQ"
                    >
                        <Icon name="fa6-brands:qq" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">QQ</span>
                    </button>
                    <!-- 微信分享 -->
                    <button
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-[#07C160] hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="wechat"
                        aria-label="分享到微信"
                        title="分享到微信"
                    >
                        <Icon name="fa6-brands:weixin" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">微信</span>
                    </button>
                    <!-- 复制链接 -->
                    <button
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="copy"
                        aria-label="复制链接"
                        title="复制链接"
                    >
                        <Icon name="fa6-solid:link" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">复制链接</span>
                    </button>
                </div>
            </div>

    <!-- 评论 -->
    <Comment post={entry} />

    <!-- 最后修改时间 -->
    {postConfig.showLastModified && (
        <>
            <div
                id="last-modified"
                class="ignore"
                data-last-modified={lastModified}
                data-translations={JSON.stringify(lastModifiedTranslations)}
                data-default-lang={langToTranslateMap[siteConfig.lang]}
                style="display: none;"
            ></div>

            <div class="card-base p-6 mb-4">
                <script is:inline>
                    function runtime() {
                        const lastModifiedElement = document.getElementById('last-modified');
                        if (!lastModifiedElement) return;
                        const startDate = new Date(lastModifiedElement.dataset.lastModified);
                        const currentDate = new Date();
                        const diff = currentDate - startDate;
                        const seconds = Math.floor(diff / 1000);
                        const days = Math.floor(seconds / 86400);
                        const hours = Math.floor((seconds % 86400) / 3600);
                        const minutes = Math.floor((seconds % 3600) / 60);
                        const secs = seconds % 60;
                        const years = Math.floor(days / 365);
                        const months = Math.floor((days % 365) / 30);
                        const remainingDays = days % 30;

                        const translations = JSON.parse(lastModifiedElement.dataset.translations);
                        const defaultLang = lastModifiedElement.dataset.defaultLang;
                        const currentLang = localStorage.getItem('selected-language') || defaultLang;

                        const langTranslations = translations[currentLang] || translations[defaultLang] || Object.values(translations)[0];

                        const prefix = langTranslations.lastModifiedPrefix;
                        const yearKey = langTranslations.year;
                        const monthKey = langTranslations.month;
                        const dayKey = langTranslations.day;
                        const hourKey = langTranslations.hour;
                        const minuteKey = langTranslations.minute;
                        const secondKey = langTranslations.second;

                        let runtimeString = prefix + ' ';
                        if (years > 0) {
                            runtimeString += `${years} ${yearKey} `;
                        }
                        if (months > 0) {
                            runtimeString += `${months} ${monthKey} `;
                        }
                        if (remainingDays > 0) {
                            runtimeString += `${remainingDays} ${dayKey} `;
                        }
                        runtimeString += `${hours} ${hourKey} `;
                        if (minutes < 10) {
                            runtimeString += `0${minutes} ${minuteKey} `;
                        } else {
                            runtimeString += `${minutes} ${minuteKey} `;
                        }
                        if (secs < 10) {
                            runtimeString += `0${secs} ${secondKey}`;
                        } else {
                            runtimeString += `${secs} ${secondKey}`;
                        }
                        document.getElementById("modifiedtime").innerHTML = runtimeString;
                    }
                    setInterval(runtime, 1000);
                </script>
                <div class="card-base p-1 mb-0.1">
                    <div class="flex items-center gap-2">
                        <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
                            <Icon
                                name="material-symbols:history-rounded"
                                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
                            />
                        </div>
                        <div class="flex flex-col gap-0.1">
                            <div id="modifiedtime" class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75 ignore"></div>
                            <p class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75">
                                {i18n(I18nKey.lastModifiedOutdated)}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </>
    )}

    <!-- 上一篇 / 下一篇 -->
    <div
        class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
    >
        <a
            href={entry.data.nextSlug
                ? getPostUrlBySlug(entry.data.nextSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.nextSlug },
            ]}
        >
            {
                entry.data.nextSlug && (
                    <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
                        <Icon
                            name="material-symbols:chevron-left-rounded"
                            class="text-[2rem] text-(--primary)"
                        />
                        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                            {entry.data.nextTitle}
                        </div>
                    </div>
                )
            }
        </a>
        <a
            href={entry.data.prevSlug
                ? getPostUrlBySlug(entry.data.prevSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.prevSlug },
            ]}
        >
            {
                entry.data.prevSlug && (
                    <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
                        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                            {entry.data.prevTitle}
                        </div>
                        <Icon
                            name="material-symbols:chevron-right-rounded"
                            class="text-[2rem] text-(--primary)"
                        />
                    </div>
                )
            }
        </a>
    </div>
</GridLayout>

<!-- ===== 新增：微信分享二维码模态框 ===== -->
<div
    id="wechat-modal"
    class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/50 backdrop-blur-sm transition-opacity duration-300"
    style="display: none; opacity: 0;"
    role="dialog"
    aria-modal="true"
    aria-label="微信分享二维码"
>
    <div
        class="bg-white dark:bg-gray-800 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all duration-300 scale-95"
        id="wechat-modal-content"
    >
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-black/80 dark:text-white/80 flex items-center gap-2">
                <Icon name="fa6-brands:weixin" class="text-[#07C160] text-2xl" />
                微信分享
            </h3>
            <button
                id="wechat-modal-close"
                class="p-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer border-0 outline-none"
                aria-label="关闭"
            >
                <Icon name="material-symbols:close-rounded" class="text-2xl text-black/50 dark:text-white/50" />
            </button>
        </div>
        <div class="flex flex-col items-center">
            <div
                id="wechat-qr-container"
                class="w-48 h-48 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center mb-3 overflow-hidden"
            >
                <img
                    id="wechat-qr-image"
                    alt="微信分享二维码"
                    class="w-full h-full object-contain"
                    loading="lazy"
                />
            </div>
            <p class="text-sm text-black/60 dark:text-white/60 text-center">
                请使用微信扫描二维码分享
            </p>
            <button
                id="wechat-copy-link-btn"
                class="mt-3 text-sm text-(--primary) hover:underline cursor-pointer border-0 bg-transparent"
            >
                或点击复制链接
            </button>
        </div>
    </div>
</div>

<!-- ===== 新增：分享 & 进度条客户端逻辑 ===== -->
<script>
    (function() {
        const previousCleanup = (window as any).__twilightPostPageCleanup;
        if (typeof previousCleanup === 'function') previousCleanup();
        const controller = new AbortController();
        const { signal } = controller;
        (window as any).__twilightPostPageCleanup = () => {
            controller.abort();
            document.body.style.overflow = '';
        };

        // ---------- 进度条 ----------
        const progressWrapper = document.getElementById('progress-bar-wrapper');
        const progressFill = document.getElementById('progress-bar-fill');
        const postContainer = document.getElementById('post-container');

        if (progressWrapper && progressFill && postContainer) {
            const progressWrapperElement = progressWrapper;
            const progressFillElement = progressFill;
            const postContainerElement = postContainer;
            let ticking = false;

            function updateProgress() {
                const articleTop = postContainerElement.getBoundingClientRect().top + window.scrollY;
                const readableDistance = Math.max(postContainerElement.offsetHeight - window.innerHeight, 1);
                const rawProgress = (window.scrollY - articleTop) / readableDistance;
                const progress = Math.min(Math.max(rawProgress, 0), 1);
                progressFillElement.style.transform = `scaleX(${progress})`;
                progressWrapperElement.classList.toggle('opacity-0', rawProgress <= 0);
                progressWrapperElement.classList.toggle('opacity-100', rawProgress > 0);
            }

            const requestProgressUpdate = () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        updateProgress();
                        ticking = false;
                    });
                    ticking = true;
                }
            };

            window.addEventListener('scroll', requestProgressUpdate, { passive: true, signal });
            window.addEventListener('resize', requestProgressUpdate, { passive: true, signal });
            updateProgress();
        }

        // ---------- 分享功能 ----------
        const currentUrl = window.location.href;
        const currentTitle = document.querySelector('[data-pagefind-meta="title"]')?.textContent?.trim() || document.title;
        const currentDesc = document.querySelector('meta[name="description"]')?.getAttribute('content') || currentTitle;

        // QQ 分享
        function shareToQQ() {
            const qqUrl =
                `https://connect.qq.com/widget/shareqq/index.html?url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(currentTitle)}&desc=${encodeURIComponent(currentDesc)}&summary=${encodeURIComponent(currentDesc)}`;
            window.open(qqUrl, '_blank', 'width=600,height=500');
        }

        // 微信分享：显示二维码
        function shareToWechat() {
            const modal = document.getElementById('wechat-modal');
            const qrImage = document.getElementById('wechat-qr-image') as HTMLImageElement | null;
            const modalContent = document.getElementById('wechat-modal-content');

            if (!modal || !qrImage) return;

            // 使用 qrserver API 生成二维码
            const qrApiUrl =
                `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(currentUrl)}`;
            qrImage.src = qrApiUrl;
            qrImage.onerror = function() {
                // 如果 API 加载失败，使用备用方案
                this.alt = '二维码加载失败，请复制链接';
                this.src = '';
            };

            modal.style.display = 'flex';
            // 触发过渡动画
            requestAnimationFrame(() => {
                modal.style.opacity = '1';
                if (modalContent) {
                    modalContent.style.transform = 'scale(1)';
                }
            });

            // 阻止背景滚动
            document.body.style.overflow = 'hidden';
        }

        // 复制链接
        function copyLink() {
            const url = currentUrl;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(() => {
                    showToast('链接已复制到剪贴板 🎉');
                }).catch(() => {
                    fallbackCopy(url);
                });
            } else {
                fallbackCopy(url);
            }
        }

        // 备用复制方案
        function fallbackCopy(text: string) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            textarea.style.top = '-9999px';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('链接已复制到剪贴板 🎉');
            } catch (err) {
                showToast('复制失败，请手动复制链接');
            }
            document.body.removeChild(textarea);
        }

        // Toast 提示
        function showToast(message: string) {
            const existing = document.getElementById('share-toast');
            if (existing) {
                existing.remove();
            }

            const toast = document.createElement('div');
            toast.id = 'share-toast';
            toast.textContent = message;
            toast.style.cssText = `
                        position: fixed;
                        bottom: 30px;
                        left: 50%;
                        transform: translateX(-50%) translateY(20px);
                        background: rgba(0, 0, 0, 0.8);
                        color: #fff;
                        padding: 12px 24px;
                        border-radius: 12px;
                        font-size: 14px;
                        z-index: 99999;
                        opacity: 0;
                        transition: all 0.3s ease;
                        backdrop-filter: blur(8px);
                        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
                        pointer-events: none;
                        font-weight: 500;
                    `;
            document.body.appendChild(toast);

            requestAnimationFrame(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateX(-50%) translateY(0)';
            });

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(20px)';
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 2500);
        }

        // ---------- 绑定分享按钮事件 ----------
        document.querySelectorAll<HTMLElement>('.share-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const type = btn.dataset.share;
                switch (type) {
                    case 'qq':
                        shareToQQ();
                        break;
                    case 'wechat':
                        shareToWechat();
                        break;
                    case 'copy':
                        copyLink();
                        break;
                    default:
                        break;
                }
            }, { signal });
        });

        // ---------- 微信模态框控制 ----------
        const wechatModal = document.getElementById('wechat-modal');
        const wechatClose = document.getElementById('wechat-modal-close');
        const wechatCopyLinkBtn = document.getElementById('wechat-copy-link-btn');

        function closeWechatModal() {
            if (!wechatModal) return;
            const modalContent = document.getElementById('wechat-modal-content');
            wechatModal.style.opacity = '0';
            if (modalContent) {
                modalContent.style.transform = 'scale(0.95)';
            }
            setTimeout(() => {
                wechatModal.style.display = 'none';
                document.body.style.overflow = '';
            }, 300);
        }

        if (wechatClose) {
            wechatClose.addEventListener('click', closeWechatModal, { signal });
        }

        if (wechatModal) {
            wechatModal.addEventListener('click', (e) => {
                if (e.target === wechatModal) {
                    closeWechatModal();
                }
            }, { signal });

            // ESC 键关闭
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && wechatModal.style.display === 'flex') {
                    closeWechatModal();
                }
            }, { signal });
        }

        if (wechatCopyLinkBtn) {
            wechatCopyLinkBtn.addEventListener('click', () => {
                copyLink();
                // 延迟关闭模态框
                setTimeout(closeWechatModal, 500);
            }, { signal });
        }
    })();
</script>

