---
// 保留所有原有的 imports 和配置
import { Icon } from "astro-icon/components";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

import { siteConfig, profileConfig, postConfig } from "@/config";
import { getRelatedPosts, getSortedPosts, type PostForList } from "@utils/post";
import { formatDateToYYYYMMDD } from "@utils/date";
import { getFileDirFromPath, getPostUrl, getPostUrlBySlug, removeFileExtension, url } from "@utils/url";
import { SUPPORTED_LANGUAGES, langToTranslateMap } from "@i18n/language";
import { i18n, getTranslation } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import License from "@components/post/license.astro";
import Markdown from "@components/common/markdown.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import PasswordProtection from "@components/common/passwordProtection.astro";
import PostMetadata from "@components/post/postMeta.astro";
import Comment from "@components/comment.astro";
import RelatedPosts from "@components/post/RelatedPosts.astro";
import GridLayout from "@layouts/grid.astro";

export async function getStaticPaths() {
    const blogEntries = await getSortedPosts();
    const paths: {
        params: { slug: string };
        props: {
            entry: CollectionEntry<"posts">;
            relatedPosts: PostForList[];
        };
    }[] = [];

    for (const entry of blogEntries) {
        const slug = removeFileExtension(entry.id);
        const relatedPosts = getRelatedPosts(entry, blogEntries);
        paths.push({
            params: { slug },
            props: { entry, relatedPosts },
        });
        if (entry.data.routeName) {
            let routeName = entry.data.routeName
                .replace(/^\/+/, "")
                .replace(/\/+$/, "");
            if (routeName.startsWith("posts/")) {
                routeName = routeName.replace(/^posts\//, "");
            }
            paths.push({
                params: { slug: routeName },
                props: { entry, relatedPosts },
            });
        }
    }

    return paths;
}

const { entry, relatedPosts } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

// 加密逻辑
let isEncrypted = !!(entry.data.encrypted && entry.data.password);

dayjs.extend(utc);
const lastModified = dayjs(entry.data.updated || entry.data.published)
    .utc()
    .format("YYYY-MM-DDTHH:mm:ss");

const lastModifiedKeys = [
    I18nKey.lastModifiedPrefix,
    I18nKey.year,
    I18nKey.month,
    I18nKey.day,
    I18nKey.hour,
    I18nKey.minute,
    I18nKey.second
];

const lastModifiedTranslations = {};
for (const lang of SUPPORTED_LANGUAGES) {
    const translateCode = langToTranslateMap[lang];
    lastModifiedTranslations[translateCode] = {};
    const translation = getTranslation(lang);
    for (const key of lastModifiedKeys) {
        lastModifiedTranslations[translateCode][key] = translation[key];
    }
}

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: entry.data.title,
    description: entry.data.description || entry.data.title,
    keywords: entry.data.tags,
    author: {
        "@type": "Person",
        name: profileConfig.name,
        url: Astro.site,
    },
    datePublished: formatDateToYYYYMMDD(entry.data.published!),
    inLanguage: entry.data.lang
        ? entry.data.lang.replace("_", "-")
        : siteConfig.lang.replace("_", "-"),
};

// 获取当前文章的完整 URL，用于分享
const postUrl = getPostUrl(entry);
const fullPostUrl = new URL(postUrl, Astro.site).toString();
const postTitle = entry.data.title;
const postDesc = entry.data.description || postTitle;
---

<GridLayout
    banner={entry.data.cover}
    title={entry.data.title}
    description={entry.data.description}
    lang={entry.data.lang}
    setOGTypeArticle={true}
    postSlug={entry.id}
    headings={headings}
    wallpaperMode="fullscreen"
>
    <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
    />

    <div
        class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
    >
        <div
            id="post-container"
            data-reading-progress
            data-reading-url={postUrl}
            data-reading-title={postTitle}
            data-reading-total-minutes={remarkPluginFrontmatter.minutes}
            class:list={[
                "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
                {},
            ]}
        >
            <nav class="post-reader-nav" aria-label={i18n(I18nKey.articleNavigation)}>
                <a
                    href={url("/?view=home")}
                    data-enter-home-directly
                    class="post-reader-nav__item"
                    aria-label={i18n(I18nKey.backToHome)}
                    title={i18n(I18nKey.backToHome)}
                >
                    <Icon name="material-symbols:arrow-back-rounded" />
                    <span>{i18n(I18nKey.backToHome)}</span>
                </a>
            </nav>

            <!-- 字数统计 & 阅读时间 -->
            <div
                class="flex flex-row flex-wrap text-black/30 dark:text-white/30 gap-x-5 gap-y-2 mb-3 transition onload-animation-up"
            >
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon name="material-symbols:notes-rounded" />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.words}
                        {" " + i18n(I18nKey.wordsCount)}
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon
                            name="material-symbols:schedule-outline-rounded"
                        />
                    </div>
                    <div class="text-sm">
                        {remarkPluginFrontmatter.minutes}
                        {" " +
                            i18n(
                                remarkPluginFrontmatter.minutes === 1
                                    ? I18nKey.minuteCount
                                    : I18nKey.minutesCount,
                            )
                        }
                    </div>
                </div>
                <div class="flex flex-row items-center">
                    <div
                        class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                    >
                        <Icon name="material-symbols:schedule-outline-rounded" />
                    </div>
                    <div
                        class="text-sm tabular-nums"
                        data-reading-status
                        data-progress-label={i18n(I18nKey.readingProgress)}
                        data-remaining-label={i18n(I18nKey.minutesRemaining)}
                    >
                        {remarkPluginFrontmatter.minutes} {i18n(I18nKey.minutesRemaining)}
                    </div>
                </div>
            </div>

            <!-- 标题 -->
            <div class="relative onload-animation-up">
                <div
                    data-pagefind-body
                    data-pagefind-weight="10"
                    data-pagefind-meta="title"
                    class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
                >
                    {entry.data.title}
                </div>
            </div>

            <!-- 元数据 -->
            <div class="onload-animation-up">
                <PostMetadata
                    className="mb-5"
                    published={entry.data.published!}
                    updated={entry.data.updated}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    postUrl={getPostUrl(entry)}
                />
                {
                    (!entry.data.cover || (entry.data.cover && !entry.data.coverInContent)) && (
                        <div class="mt-4 border-(--line-divider) border-dashed border-b mb-5" />
                    )
                }
            </div>

            <!-- 封面图 -->
            {
                entry.data.cover && entry.data.coverInContent && (
                    <>
                        <div class="mt-4" />
                        <ImageWrapper
                            id="post-cover"
                            src={entry.data.cover}
                            basePath={getFileDirFromPath(entry.filePath || '')}
                            class="mb-8 rounded-xl banner-container onload-animation-up"
                            loading="lazy"
                        />
                    </>
                )
            }

            <!-- 正文 -->
            <PasswordProtection
                isEncrypted={isEncrypted}
                password={entry.data.password}
            >
                <Markdown class="mb-6 markdown-content onload-animation-up">
                    <Content />
                </Markdown>
                {
                    postConfig.license.enable && (
                        <License
                            title={entry.data.title}
                            id={entry.id}
                            pubDate={entry.data.published!}
                            author={entry.data.author}
                            sourceLink={entry.data.sourceLink}
                            licenseName={entry.data.licenseName}
                            licenseUrl={entry.data.licenseUrl}
                            postUrl={getPostUrl(entry)}
                            class="mb-6 rounded-xl license-container onload-animation-up"
                        />
                    )
                }
            </PasswordProtection>
        </div>
    </div>

    <!-- 分享按钮组（使用 fa6-brands / fa6-solid 图标） -->
            <div
                class="onload-animation-up mb-4"
                data-post-share
                data-share-url={fullPostUrl}
                data-share-title={postTitle}
                data-share-description={postDesc}
            >
                <div class="flex flex-wrap items-center gap-2 text-black/60 dark:text-white/60 text-sm">
                    <span class="mr-1 select-none">{i18n(I18nKey.share)}</span>
                    <!-- QQ 分享 -->
                    <button
                        type="button"
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="qq"
                        aria-haspopup="dialog"
                        aria-label={i18n(I18nKey.shareToQQ)}
                        title={i18n(I18nKey.shareToQQ)}
                    >
                        <Icon name="fa6-brands:qq" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">QQ</span>
                    </button>
                    <!-- 微信分享 -->
                    <button
                        type="button"
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-[#07C160] hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="wechat"
                        aria-controls="wechat-modal"
                        aria-expanded="false"
                        aria-haspopup="dialog"
                        aria-label={i18n(I18nKey.shareToWechat)}
                        title={i18n(I18nKey.shareToWechat)}
                    >
                        <Icon name="fa6-brands:weixin" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">{i18n(I18nKey.wechat)}</span>
                    </button>
                    <!-- 复制链接 -->
                    <button
                        type="button"
                        class="share-btn group flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="copy"
                        aria-label={i18n(I18nKey.copyLink)}
                        title={i18n(I18nKey.copyLink)}
                    >
                        <Icon name="fa6-solid:link" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline" data-share-label data-default-label={i18n(I18nKey.copyLink)}>{i18n(I18nKey.copyLink)}</span>
                    </button>
                    <!-- 支持 Web Share API 的设备显示系统分享入口。 -->
                    <button
                        type="button"
                        class="share-btn native-share-btn group hidden items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/10 hover:bg-(--primary) hover:text-white dark:hover:text-white transition-all duration-200 cursor-pointer border-0 outline-none"
                        data-share="native"
                        aria-label={i18n(I18nKey.nativeShare)}
                        title={i18n(I18nKey.nativeShare)}
                    >
                        <Icon name="fa6-solid:share-nodes" class="text-base" />
                        <span class="text-xs font-medium hidden sm:inline">{i18n(I18nKey.nativeShare)}</span>
                    </button>
                </div>
    </div>

    <RelatedPosts posts={relatedPosts} />

    <!-- 评论 -->
    <Comment post={entry} />

    <!-- 最后修改时间 -->
    {postConfig.showLastModified && (
        <>
            <div
                id="last-modified"
                class="ignore"
                data-last-modified={lastModified}
                data-translations={JSON.stringify(lastModifiedTranslations)}
                data-default-lang={langToTranslateMap[siteConfig.lang]}
                style="display: none;"
            ></div>

            <div class="card-base p-6 mb-4">
                <div class="card-base p-1 mb-0.1">
                    <div class="flex items-center gap-2">
                        <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
                            <Icon
                                name="material-symbols:history-rounded"
                                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
                            />
                        </div>
                        <div class="flex flex-col gap-0.1">
                            <div id="modifiedtime" class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75 ignore"></div>
                            <p class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75">
                                {i18n(I18nKey.lastModifiedOutdated)}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </>
    )}

    <!-- 上一篇 / 下一篇 -->
    <div
        class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
    >
        <a
            href={entry.data.nextSlug
                ? getPostUrlBySlug(entry.data.nextSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.nextSlug },
            ]}
        >
            {
                entry.data.nextSlug && (
                    <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
                        <Icon
                            name="material-symbols:chevron-left-rounded"
                            class="text-[2rem] text-(--primary)"
                        />
                        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                            {entry.data.nextTitle}
                        </div>
                    </div>
                )
            }
        </a>
        <a
            href={entry.data.prevSlug
                ? getPostUrlBySlug(entry.data.prevSlug)
                : "#"}
            class:list={[
                "w-full font-bold overflow-hidden active:scale-95",
                { "pointer-events-none": !entry.data.prevSlug },
            ]}
        >
            {
                entry.data.prevSlug && (
                    <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
                        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
                            {entry.data.prevTitle}
                        </div>
                        <Icon
                            name="material-symbols:chevron-right-rounded"
                            class="text-[2rem] text-(--primary)"
                        />
                    </div>
                )
            }
        </a>
    </div>
<!-- ===== 新增：微信分享二维码模态框 ===== -->
<div
    id="wechat-modal"
    slot="page-overlay"
    class="fixed bottom-5 left-1/2 z-[9999] w-[min(22rem,calc(100vw-2rem))]"
    hidden
    role="dialog"
    aria-modal="false"
    aria-label={i18n(I18nKey.wechatShareQr)}
>
    <div
        class="border border-black/10 bg-white/95 p-5 shadow-2xl backdrop-blur-xl dark:border-white/15 dark:bg-gray-800/95 rounded-2xl w-full transform transition-all duration-300 scale-95"
        id="wechat-modal-content"
    >
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold text-black/80 dark:text-white/80 flex items-center gap-2">
                <Icon name="fa6-brands:weixin" class="text-[#07C160] text-2xl" />
                {i18n(I18nKey.shareToWechat)}
            </h3>
            <button
                type="button"
                id="wechat-modal-close"
                class="p-1.5 rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer border-0 outline-none"
                aria-label={i18n(I18nKey.close)}
            >
                <Icon name="material-symbols:close-rounded" class="text-2xl text-black/50 dark:text-white/50" />
            </button>
        </div>
        <div class="flex flex-col items-center">
            <div
                id="wechat-qr-container"
                class="w-48 h-48 bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center mb-3 overflow-hidden"
            >
                <span data-wechat-qr-status class="px-4 text-center text-sm text-black/55 dark:text-white/55">{i18n(I18nKey.qrGenerating)}</span>
                <img
                    id="wechat-qr-image"
                    alt={i18n(I18nKey.wechatShareQr)}
                    class="w-full h-full object-contain"
                    loading="lazy"
                />
            </div>
            <p class="text-sm text-black/60 dark:text-white/60 text-center">
                {i18n(I18nKey.scanWechatQr)}
            </p>
            <p class="mt-1 text-xs text-black/40 dark:text-white/40">{i18n(I18nKey.articleStaysOnPage)}</p>
            <button
                type="button"
                id="wechat-copy-link-btn"
                class="mt-3 text-sm text-(--primary) hover:underline cursor-pointer border-0 bg-transparent"
            >
                <span data-share-label data-default-label={i18n(I18nKey.clickToCopyLink)}>{i18n(I18nKey.clickToCopyLink)}</span>
            </button>
        </div>
    </div>
</div>
</GridLayout>

<style is:global>
    .post-reader-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px dashed var(--line-divider);
    }

    .post-reader-nav__item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-height: 2.5rem;
        padding: 0.45rem 0.8rem;
        border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
        border-radius: 0.75rem;
        background: var(--btn-regular-bg);
        color: color-mix(in srgb, currentColor 72%, transparent);
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .post-reader-nav__item:hover {
        color: var(--primary);
        border-color: color-mix(in srgb, var(--primary) 58%, transparent);
        background: color-mix(in srgb, var(--primary) 10%, var(--btn-regular-bg));
        transform: translateY(-1px);
    }

    .post-reader-nav__item:active {
        transform: scale(0.97);
    }

    .post-reader-nav__item svg {
        width: 1.15rem;
        height: 1.15rem;
        color: var(--primary);
    }

    /* 分享按钮悬停效果增强 */
    .share-btn {
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .share-btn:active {
        transform: scale(0.92);
    }

    /* 微信模态框动画 */
    #wechat-modal {
        transform: translate(-50%, 0.8rem);
        transition: opacity 0.26s ease, transform 0.26s ease;
        opacity: 0;
    }

    #wechat-modal[hidden] {
        display: none !important;
    }

    #wechat-modal.is-open {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    #wechat-modal-content {
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    #wechat-modal.is-open #wechat-modal-content {
        transform: scale(1);
    }

    /* Toast 提示动画 */
    #share-toast {
        position: fixed;
        left: 50%;
        bottom: max(1.9rem, env(safe-area-inset-bottom));
        z-index: 99999;
        max-width: min(90vw, 28rem);
        padding: 0.72rem 1.15rem;
        border: 1px solid rgb(255 255 255 / 18%);
        border-radius: 0.8rem;
        background: rgb(13 18 35 / 88%);
        color: white;
        box-shadow: 0 0.75rem 2.4rem rgb(0 0 0 / 28%);
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 1rem);
        transition: opacity 0.24s ease, transform 0.24s ease;
        backdrop-filter: blur(0.7rem);
        will-change: transform, opacity;
    }

    #share-toast[data-tone="warning"] {
        border-color: rgb(251 191 36 / 38%);
    }

    #share-toast.is-visible {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    .share-btn.is-success {
        background: #18a06f;
        color: white;
    }

    /* 暗色模式下二维码容器适配 */
    @media (prefers-color-scheme: dark) {
        #wechat-qr-container {
            background: #1f2937;
        }
    }

    /* 移动端适配：小屏幕下分享按钮文字隐藏 */
    @media (max-width: 480px) {
        .share-btn {
            padding-left: 10px;
            padding-right: 10px;
        }
        .share-btn span {
            display: none !important;
        }
    }
</style>
