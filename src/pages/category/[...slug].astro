---
// src/pages/category/[...slug].astro

import { getCollection } from "astro:content";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import { formatDateToYYYYMMDD } from "@utils/date";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { CATEGORY_SEPARATOR } from "@utils/category";
import { getCategoryList, getSortedPostsList } from "@utils/post";

// 生成所有分类的静态路径
export async function getStaticPaths() {
  const categories = await getCategoryList();
  return categories.map((cat) => ({
    params: { slug: cat.name },
    props: { categoryName: cat.name, categoryCount: cat.count },
  }));
}

// 接收 props 和 params
const { categoryName, categoryCount } = Astro.props;
const slug = Astro.params.slug;
const slugParts = slug ? slug.split(CATEGORY_SEPARATOR).filter(Boolean) : [];

// 获取所有文章和分类列表
const allPosts = await getSortedPostsList();
const allCategories = await getCategoryList();

// 过滤出当前分类下的文章（精确匹配）
const filteredPosts = allPosts.filter((post) => {
  const postCat = post.data.category;
  if (!postCat) return false;
  const parts = Array.isArray(postCat) ? postCat : [postCat];
  return parts.length === slugParts.length && parts.every((p, i) => p === slugParts[i]);
});

// 构建面包屑
const breadcrumbItems = slugParts.map((part, idx) => ({
  name: part,
  url: "/category/" + slugParts.slice(0, idx + 1).join(CATEGORY_SEPARATOR) + "/",
}));

// 父级分类 URL（如果有）
const parentSlug = slugParts.length > 1 ? slugParts.slice(0, -1).join(CATEGORY_SEPARATOR) : null;
const parentUrl = parentSlug ? "/category/" + parentSlug + "/" : null;

// 子分类列表（直接子级）
const childCategories = allCategories.filter((cat) => {
  const parts = cat.name.split(CATEGORY_SEPARATOR).filter(Boolean);
  return (
    parts.length === slugParts.length + 1 &&
    parts.slice(0, slugParts.length).every((p, i) => p === slugParts[i])
  );
});

// 页面标题（取最后一级）
const pageTitle = slugParts[slugParts.length - 1] || categoryName;
const pageDescription = i18n(I18nKey.postsCount) + `：${filteredPosts.length}`;
---

<GridLayout title={pageTitle} description={pageDescription}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <BackwardButton currentPath={Astro.url.pathname} />

      <!-- 面包屑导航 -->
      <nav class="text-sm text-60 mb-4 flex flex-wrap items-center gap-1">
        <a href="/" class="hover:text-(--primary) transition-colors">首页</a>
        <span class="mx-1">/</span>
        <a href="/posts/" class="hover:text-(--primary) transition-colors">分类</a>
        {breadcrumbItems.map((item, index) => (
          <>
            <span class="mx-1">/</span>
            {index === breadcrumbItems.length - 1 ? (
              <span class="text-90 font-medium">{item.name}</span>
            ) : (
              <a href={item.url} class="hover:text-(--primary) transition-colors">
                {item.name}
              </a>
            )}
          </>
        ))}
      </nav>

      <!-- 标题区 -->
      <header class="mb-6">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {pageTitle}
        </h1>
        <p class="text-neutral-600 dark:text-neutral-400">
          {i18n(I18nKey.postsCount)}：{filteredPosts.length} 篇文章
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a
            href="/posts/"
            class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--primary) text-white"
          >
            {i18n(I18nKey.postsAll) || "返回全部"}
          </a>
          {parentUrl && (
            <a
              href={parentUrl}
              class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--card-bg) hover:bg-(--primary)/10 border border-(--line-divider)"
            >
              ← 返回上级
            </a>
          )}
        </div>
      </header>

      <!-- 子分类列表（如果有） -->
      {childCategories.length > 0 && (
        <div class="mb-8">
          <h2 class="text-sm font-semibold text-60 uppercase tracking-wider mb-3">子分类</h2>
          <div class="flex flex-wrap gap-2">
            {childCategories.map((child) => (
              <a
                href={"/category/" + encodeURIComponent(child.name) + "/"}
                class="inline-flex items-center px-4 py-2 rounded-full text-sm bg-(--card-bg) border border-(--line-divider) hover:border-(--primary) hover:text-(--primary) transition-all"
              >
                {child.name.split(CATEGORY_SEPARATOR).pop()}
                <span class="ml-1.5 text-xs opacity-60">({child.count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 文章列表 -->
      <div class="space-y-6">
        {filteredPosts.length === 0 ? (
          <p class="text-center text-60 py-12">该分类下暂无文章</p>
        ) : (
          filteredPosts.map((post) => (
            <article class="group bg-(--card-bg) rounded-xl p-6 border border-(--line-divider) hover:border-(--primary) transition-all duration-300 hover:shadow-lg">
              <a href={`/posts/${post.id}/`} class="block">
                <h2 class="text-xl font-semibold text-90 group-hover:text-(--primary) transition-colors mb-2">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-75 mb-3 line-clamp-2">
                    {post.data.description}
                  </p>
                )}
                <div class="flex flex-wrap items-center gap-4 text-sm text-60">
                  <time datetime={post.data.published.toISOString()} class="text-75">
                    {formatDateToYYYYMMDD(post.data.published)}
                  </time>
                  <!-- 分类标签（可点击） -->
                  {post.data.category && (
                    <a
                      href={"/category/" + encodeURIComponent(Array.isArray(post.data.category) ? post.data.category[0] : post.data.category) + "/"}
                      class="px-2 py-0.5 bg-(--primary)/10 text-(--primary) rounded-full text-xs hover:bg-(--primary) hover:text-white transition-colors"
                    >
                      {Array.isArray(post.data.category) ? post.data.category[0] : post.data.category}
                    </a>
                  )}
                  <!-- 标签 -->
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {post.data.tags.slice(0, 2).map((tag) => (
                        <span class="px-2 py-0.5 bg-black/5 dark:bg-white/5 text-60 rounded-full text-xs">
                          {tag}
                        </span>
                      ))}
                      {post.data.tags.length > 2 && (
                        <span class="text-60 text-xs">+{post.data.tags.length - 2}</span>
                      )}
                    </div>
                  )}
                </div>
              </a>
            </article>
          ))
        )}
      </div>

      <!-- 回到顶部 -->
      <div class="mt-8 text-center">
        <a href="#top-row" class="text-60 text-xs hover:text-(--primary) transition-colors">
          ↑ 回到顶部
        </a>
      </div>
    </div>
  </div>
</GridLayout>