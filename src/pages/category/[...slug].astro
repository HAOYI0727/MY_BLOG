---
// src/pages/category/[...slug].astro

import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import PostCollectionGrid from "@components/PostCollectionGrid.astro";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { CATEGORY_SEPARATOR, getCategoryPathParts } from "@utils/category";
import { getCategoryList, getSortedPostsList } from "@utils/post";
import { getCategoryUrl } from "@utils/url";

// 生成所有分类的静态路径
export async function getStaticPaths() {
  const categories = await getCategoryList();
  const categoryPrefixes = new Map<string, number>();

  for (const category of categories) {
    const parts = category.name.split(CATEGORY_SEPARATOR).filter(Boolean);
    parts.forEach((_, index) => {
      const prefix = parts.slice(0, index + 1).join(CATEGORY_SEPARATOR);
      categoryPrefixes.set(prefix, (categoryPrefixes.get(prefix) || 0) + category.count);
    });
  }

  return Array.from(categoryPrefixes, ([name, count]) => ({
    params: { slug: name },
    props: { categoryName: name, categoryCount: count },
  }));
}

// 接收 props 和 params
const { categoryName } = Astro.props;
const slug = Astro.params.slug;
const slugParts = slug ? slug.split(CATEGORY_SEPARATOR).filter(Boolean) : [];

// 获取所有文章和分类列表
const allPosts = await getSortedPostsList();
const allCategories = await getCategoryList();

// 过滤出当前分类下的文章（精确匹配）
const filteredPosts = allPosts.filter((post) => {
  const parts = getCategoryPathParts(post.data.category);
  if (!parts) return false;
  return parts.length >= slugParts.length && slugParts.every((part, index) => parts[index] === part);
});

// 构建面包屑
const breadcrumbItems = slugParts.map((part, idx) => ({
  name: part,
  url: getCategoryUrl(slugParts.slice(0, idx + 1)),
}));

// 父级分类 URL（如果有）
const parentSlug = slugParts.length > 1 ? slugParts.slice(0, -1).join(CATEGORY_SEPARATOR) : null;
const parentUrl = parentSlug ? getCategoryUrl(parentSlug.split(CATEGORY_SEPARATOR)) : null;

// 子分类列表（直接子级）
const childCategories = allCategories.filter((cat) => {
  const parts = cat.name.split(CATEGORY_SEPARATOR).filter(Boolean);
  return (
    parts.length === slugParts.length + 1 &&
    parts.slice(0, slugParts.length).every((p, i) => p === slugParts[i])
  );
});

// 页面标题（取最后一级）
const pageTitle = slugParts[slugParts.length - 1] || categoryName;
const pageDescription = `${filteredPosts.length} ${i18n(I18nKey.postsCount)}`;
---

<GridLayout title={pageTitle} description={pageDescription}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <BackwardButton currentPath={Astro.url.pathname} />

      <!-- 面包屑导航 -->
      <nav class="text-sm text-60 mb-4 flex flex-wrap items-center gap-1">
        <a href="/" class="hover:text-(--primary) transition-colors">{i18n(I18nKey.home)}</a>
        <span class="mx-1">/</span>
        <a href="/posts/" class="hover:text-(--primary) transition-colors">{i18n(I18nKey.categories)}</a>
        {breadcrumbItems.map((item, index) => (
          <>
            <span class="mx-1">/</span>
            {index === breadcrumbItems.length - 1 ? (
              <span class="text-90 font-medium">{item.name}</span>
            ) : (
              <a href={item.url} class="hover:text-(--primary) transition-colors">
                {item.name}
              </a>
            )}
          </>
        ))}
      </nav>

      <!-- 标题区 -->
      <header class="mb-6">
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
          {pageTitle}
        </h1>
        <p class="text-neutral-600 dark:text-neutral-400">
          {filteredPosts.length} {i18n(I18nKey.postsCount)}
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a
            href="/posts/"
            class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--primary) text-white"
          >
            {i18n(I18nKey.postsAll)}
          </a>
          {parentUrl && (
            <a
              href={parentUrl}
              class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--card-bg) hover:bg-(--primary)/10 border border-(--line-divider)"
            >
              ← {i18n(I18nKey.backToParent)}
            </a>
          )}
        </div>
      </header>

      <!-- 子分类列表（如果有） -->
      {childCategories.length > 0 && (
        <div class="mb-8">
          <h2 class="text-sm font-semibold text-60 uppercase tracking-wider mb-3">{i18n(I18nKey.subcategories)}</h2>
          <div class="flex flex-wrap gap-2">
            {childCategories.map((child) => (
              <a
                href={getCategoryUrl(child.name.split(CATEGORY_SEPARATOR))}
                class="inline-flex items-center px-4 py-2 rounded-full text-sm bg-(--card-bg) border border-(--line-divider) hover:border-(--primary) hover:text-(--primary) transition-all"
              >
                {child.name.split(CATEGORY_SEPARATOR).pop()}
                <span class="ml-1.5 text-xs opacity-60">({child.count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 与月份归档一致的三列文章卡片视图。 -->
      <PostCollectionGrid posts={filteredPosts} emptyText={i18n(I18nKey.categoryEmpty)} />

      <!-- 回到顶部 -->
      <div class="mt-8 text-center">
        <a href="#top-row" class="text-60 text-xs hover:text-(--primary) transition-colors">
          ↑ {i18n(I18nKey.backToTop)}
        </a>
      </div>
    </div>
  </div>
</GridLayout>
